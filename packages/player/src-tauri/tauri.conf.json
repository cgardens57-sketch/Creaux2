{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Creaux2",
  "mainBinaryName": "creaux2",
  "version": "2.0.0",
  "identifier": "studio.creaux2.nuclear",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "cd ../.. && pnpm --filter @nuclearplayer/player build:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Creaux2 - Listening Observatory",
        "width": 1440,
        "height": 900,
        "minWidth": 860,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "shortDescription": "A crystalline, source-independent music player",
    "longDescription": "Creaux2 is a source-independent listening observatory built on Nuclear's open music architecture.",
    "copyright": "Copyright 2025-2026 nukeop; Creaux2 interface 2026",
    "homepage": "https://github.com/nukeop/nuclear",
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      },
      "rpm": {
        "epoch": 0,
        "files": {},
        "release": "1"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczRDk0QzBFODNCNDEyNUUKUldSZUVyU0REa3paYzdTaE9IdlErcjNoTmdyMkNLL0d3alFZTHVMcytxQzJ3K1NJRlFWQlVaYk4K",
      "endpoints": [
        "https://github.com/nukeop/nuclear/releases/latest/download/latest.json"
      ]
    }
  }
}
